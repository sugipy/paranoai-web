  /* ── トップ（ParanoAI 導入支援の入口）追加分 2026-10-25 ── */
  :root {
    --ink: #16211B;
    --ink-3: #67716B;
    --grad: linear-gradient(135deg, #2F7A5C 0%, #1F5A45 50%, #123A2C 100%);
  }
  .logo-mark { background: var(--grad); color: #fff; font-weight: 800; font-size: 1rem; }
  .btn-primary { background: var(--grad); }
  .btn-primary:hover { background: var(--brand-d); }
  .hero .hero-points svg { color: var(--brand); }

  /* ヒーロー右: 白地の上に、AIが作業中のパソコン画面を1枚 */
  .visual.top-vis { min-height: 0; display: block; }
  .top-vis .console { padding-bottom: 18px; color: #fff; }
  .top-badge {
    position: relative; margin-bottom: 14px; display: inline-flex; align-items: center; gap: 10px;
    background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 10px 14px; box-shadow: var(--shadow);
    font-weight: 800; font-size: .8125rem; line-height: 1.45;
  }
  .top-badge .ic { width: 34px; height: 34px; border-radius: 50%; background: var(--brand-l); color: var(--brand); display: grid; place-items: center; flex: none; }
  .top-badge .ic svg { width: 18px; height: 18px; }
  .top-vis .cs-wrap { display: flex; flex-direction: column; align-items: flex-start; }
  .top-vis .console { align-self: stretch; }
  .top-results { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }
  .tr { padding: 12px 14px; font-size: .75rem; line-height: 1.5; display: grid; gap: 8px; align-content: start; }
  .tr .bm-bar { margin: 0; }
  .tr .shift { margin: 0; grid-template-columns: 1.7fr repeat(5, 1fr); }
  .tr-bars { display: flex; align-items: flex-end; gap: 5px; height: 34px; }
  .tr-bars i { flex: 1; border-radius: 3px 3px 0 0; background: var(--brand); opacity: .85; }
  .tr-note { display: flex; align-items: center; gap: 6px; font-weight: 700; color: var(--brand-d); }
  .tr-note svg { width: 16px; height: 16px; color: var(--brand); flex: none; }
  .top-vis .img-note { position: static; text-align: right; margin: 10px 0 0; font-size: .75rem; color: var(--ink-3); }
  @media (max-width: 559px) { .top-results { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .top-vis *, .top-vis *::before, .top-vis *::after { animation: none !important; } }
  .stats-note { grid-column: 1 / -1; border-top: 1px solid var(--line); padding: 8px 16px; font-size: .75rem; color: var(--ink-3); text-align: center; }

  /* 実例（4件を2列で） */
  .case-more { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 20px; margin-top: 36px; }
  .case-more p { font-size: .8125rem; color: var(--ink-3); }

  /* 困りごと別の入口 */
  .doors { display: grid; gap: 20px; }
  @media (min-width: 900px) { .doors { grid-template-columns: 1fr 1fr; } }
  .door { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .door-h { display: flex; align-items: center; gap: 14px; }
  .door-h .ic { width: 48px; height: 48px; border-radius: 14px; background: var(--brand-l); color: var(--brand); display: grid; place-items: center; flex: none; }
  .door-h .ic svg { width: 24px; height: 24px; }
  .door-h p { font-weight: 800; font-size: 1.125rem; line-height: 1.5; }
  .door-to { display: flex; align-items: center; gap: 6px; font-size: .8125rem; font-weight: 700; color: var(--brand); }
  .door-to svg { width: 16px; height: 16px; transform: rotate(90deg); }
  .prods { list-style: none; margin: 0; padding: 0; display: grid; }
  .prods li { border-top: 1px solid var(--line); }
  .prods a { display: grid; grid-template-columns: minmax(0, 1fr) auto 18px; gap: 12px; align-items: center; padding: 14px 2px; text-decoration: none; }
  .prods a:hover b { color: var(--brand); text-decoration: underline; }
  .prods b { display: block; font-size: 1rem; line-height: 1.5; }
  .prods small { display: block; font-size: .8125rem; color: var(--ink-2); line-height: 1.6; }
