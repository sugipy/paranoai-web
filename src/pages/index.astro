  .pa-h { font-size: .75rem; font-weight: 800; color: var(--ink-3); letter-spacing: .04em; margin-bottom: 6px; }
  .pa-row { display: grid; grid-template-columns: 20px minmax(0, 1fr) auto; gap: 10px; align-items: center; background: var(--brand-ll); border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; font-size: .875rem; font-weight: 700; line-height: 1.5; margin-bottom: 6px; }
  .pa-row svg { width: 20px; height: 20px; color: var(--ok); }
