  .cs-tasks .st svg { width: 13px; height: 13px; }
  .cs-tasks .run { border-color: rgba(110,231,183,.4); background: rgba(52,211,153,.09); }
  .cs-tasks .run .st { background: none; border: 2px solid rgba(110,231,183,.25); border-top-color: #6EE7B7; animation: spin .9s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
