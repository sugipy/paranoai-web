  .ai-float {
    position: absolute; left: 18px; bottom: -18px; display: inline-flex; align-items: center; gap: 6px;
    background: var(--accent); color: var(--ink); font-weight: 800; font-size: .8125rem; border-radius: 999px; padding: 8px 16px; box-shadow: 0 10px 24px rgba(0,0,0,.35);
  }
