  .cs-prog i { display: block; height: 100%; width: 62%; border-radius: inherit; background: linear-gradient(90deg, #34D399, #93E9FF); animation: prog 2.4s ease-in-out infinite alternate; }
  @keyframes prog { from { width: 35%; } to { width: 85%; } }
  .cs-foot { display: flex; align-items: center; gap: 10px; font-size: .8125rem; line-height: 1.55; color: rgba(255,255,255,.84); padding-top: 12px; border-top: 1px dashed rgba(255,255,255,.14); }
