  .final .btn-ghost svg, .btn-ghost svg { width: 1.1em; height: 1.1em; }

  /* 手元に残るもの・講師・流れのイラスト */
  .img-note.c { position: static; text-align: center; font-size: .75rem; color: var(--ink-3); margin: 12px 0 40px; }
  .pc-after { display: grid; gap: 16px; }
  @media (min-width: 768px) { .pc-after { grid-template-columns: 1.35fr 1fr; } }
  .pa-win { padding: 16px 18px; display: grid; gap: 12px; align-content: start; }
