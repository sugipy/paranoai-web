  .r-ic { width: 48px; height: 48px; border-radius: 14px; background: var(--brand-l); color: var(--brand); display: grid; place-items: center; margin-bottom: 14px; }
  .r-ic svg { width: 24px; height: 24px; }

  /* 料金の目安 */
  .price-list { max-width: 860px; margin: 0 auto; background: #fff; border: 1px solid var(--line); border-radius: 24px; box-shadow: var(--shadow-s); overflow: hidden; }
  .price-list .row { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 16px; align-items: center; padding: 16px 24px; border-top: 1px solid var(--line); }
