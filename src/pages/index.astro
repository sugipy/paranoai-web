---
// トップ（ParanoAI 導入支援の入口）。2026-10-25 作り直し: 見本＝/store-ax/ の骨格と部品（public/store-ax/index.html の CSS を複製）。
// Base レイアウトと Arc UI の部品は使わない（明朝の読み込みと foundation.css を外すため）。CSS とスクリプトは is:inline でそのまま出す。
const title = "ParanoAI｜AIの使い方より、今日の仕事を一緒に片付ける導入支援";
const description = "ParanoAI は、講師が横に座って、あなたのパソコンでその日の仕事をAIと片付けるところから始めるAI導入支援です。AIエージェント研修、HPお引っ越し、LINE運用代行、YouTube立ち上げ支援、Slackアプリ（リマインド人・勤タイ人、いまは先行登録）を、困りごと別にご案内します。";
const url = new URL("/", Astro.site).href;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title}>
<meta property="og:description" content="横に座って、今日の仕事をAIと片付ける。研修・HPお引っ越し・LINE運用代行・YouTube立ち上げ支援・Slackアプリ（先行登録）。">
<meta property="og:url" content={url}>
<meta property="og:type" content="website">
<link rel="canonical" href={url}>
<meta name="color-scheme" content="light">
<style is:inline>
  :root {
    --brand: #1F5A45;
    --brand-d: #123A2C;
    --brand-l: #E4F0E9;
    --brand-ll: #F3F8F5;
    --accent: #FFD43B;
    --ok: #1F9D61;
    --ok-l: #E5F6EE;
    --wip: #B86E00;
    --wip-l: #FFF3DD;
    --ink: #17202E;
    --ink-2: #4B5563;
    --ink-3: #8A93A1;
    --line: #E1E8E3;
    --bg: #FFFFFF;
    --bg-2: #F4F7F5;
    --radius: 16px;
    --shadow: 0 10px 30px rgba(23, 42, 90, .10);
    --shadow-s: 0 4px 14px rgba(23, 42, 90, .08);
    --font: "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", YuGothic, "Noto Sans JP", Meiryo, sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "palt" 1;
  }
  img, svg { display: block; }
  a { color: inherit; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .container { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 768px) { .container { padding: 0 32px; } }

  /* ── ボタン ── */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5em;
    border-radius: 999px; font-weight: 700; text-decoration: none; letter-spacing: .02em;
    padding: .9em 1.8em; font-size: 1rem; line-height: 1.2;
    transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    white-space: nowrap;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn-primary { background: var(--brand); color: #fff; box-shadow: 0 6px 16px rgba(31, 90, 69, .3); }
  .btn-primary:hover { background: var(--brand-d); }
  .btn-ghost { background: #fff; color: var(--brand); border: 2px solid var(--brand); }
  .btn-ghost:hover { background: var(--brand-l); }
  .btn-lg { padding: 1.05em 2.2em; font-size: 1.0625rem; }
  .btn svg { width: 1.1em; height: 1.1em; }
  .btn-wrap { display: inline-flex; flex-direction: column; align-items: center; gap: 6px; }
  .bubble {
    position: relative; background: var(--accent); color: var(--ink); font-size: .75rem; font-weight: 700;
    border-radius: 999px; padding: .2em .9em; line-height: 1.6;
  }
  .bubble::after {
    content: ""; position: absolute; left: 50%; bottom: -5px; transform: translateX(-50%);
    border: 5px solid transparent; border-top-color: var(--accent); border-bottom: 0;
  }

  /* ── ヘッダー ── */
  .site-header {
    position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.94);
    backdrop-filter: saturate(1.4) blur(8px); border-bottom: 1px solid var(--line);
  }
  .site-header .container { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; font-size: 1.125rem; letter-spacing: .02em; }
  .logo-mark { width: 32px; height: 32px; border-radius: 9px; background: var(--brand); display: grid; place-items: center; flex: none; }
  .logo-mark svg { width: 20px; height: 20px; }
  img.logo-mark { background: #dde1f4; object-fit: cover; }
  .logo small { display: block; font-size: .625rem; font-weight: 500; color: var(--ink-3); letter-spacing: .04em; line-height: 1.2; }
  .nav { display: none; gap: 28px; font-size: .875rem; font-weight: 600; }
  .nav a { text-decoration: none; color: var(--ink-2); }
  .nav a:hover { color: var(--brand); }
  .header-cta { display: flex; gap: 8px; }
  .header-cta .btn { padding: .6em 1.2em; font-size: .875rem; }
  .header-cta .btn-ghost { display: none; }
  @media (min-width: 1120px) { .nav { display: flex; } }
  .nav a { white-space: nowrap; }
  .logo-t { white-space: nowrap; }
  @media (max-width: 559px) { .logo-t { font-size: .875rem; } .logo-t small { display: none; } }
  .logo > span:last-child { white-space: nowrap; }
  @media (max-width: 400px) { .logo { font-size: .9375rem; gap: 8px; } .header-cta .btn { padding: .55em 1em; font-size: .8125rem; } }
  @media (min-width: 560px) { .header-cta .btn-ghost { display: inline-flex; } }
  @media (max-width: 360px) { .logo > span:last-child { white-space: normal; } .logo-t { font-size: .8125rem; line-height: 1.3; } }

  /* ── ヒーロー ── */
  .hero {
    position: relative; overflow: hidden;
    background:
      radial-gradient(1200px 500px at 85% -10%, #D8EBE0 0%, transparent 60%),
      linear-gradient(180deg, var(--brand-ll) 0%, #fff 100%);
    padding: 48px 0 88px;
  }
  .hero .container { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .hero { padding: 72px 0 120px; } .hero .container { grid-template-columns: 1.05fr 1fr; gap: 48px; } }
  .tag {
    display: inline-flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line);
    border-radius: 999px; padding: 6px 14px 6px 6px; font-size: .8125rem; font-weight: 700; color: var(--ink-2);
    box-shadow: var(--shadow-s);
  }
  .tag b { background: var(--brand); color: #fff; border-radius: 999px; padding: 2px 10px; font-size: .75rem; }
  .hero h1 {
    font-size: clamp(1.75rem, 4.2vw, 3rem); line-height: 1.36; font-weight: 800; letter-spacing: .01em;
    margin: 20px 0 20px;
  }
  .nw { white-space: nowrap; }
  .hl { background: linear-gradient(transparent 62%, var(--accent) 62%); }
  .hero h1 .blue { color: var(--brand); }
  .hero .lead { font-size: 1.0625rem; color: var(--ink-2); margin: 0 0 32px; max-width: 34em; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; }
  .hero-points { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 28px 0 0; padding: 0; list-style: none; font-size: .875rem; font-weight: 600; color: var(--ink-2); }
  .hero-points li { display: flex; align-items: center; gap: 6px; }
  .hero-points svg { width: 18px; height: 18px; color: var(--ok); flex: none; }

  /* ヒーローの画面イメージ */
  .visual { position: relative; min-height: 440px; }
  .card { background: #fff; border-radius: 14px; box-shadow: var(--shadow); border: 1px solid var(--line); }
  .v-form { position: absolute; left: 0; top: 10px; width: 62%; padding: 16px 18px; }
  .v-form .bar { display: flex; gap: 5px; margin-bottom: 12px; }
  .v-form .bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--line); }
  .v-form .done { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: .9375rem; }
  .v-form .done svg { width: 22px; height: 22px; color: var(--ok); flex: none; }
  .v-form .label { font-size: .6875rem; color: var(--ink-3); margin-top: 10px; }
  .v-form .num { font-family: var(--mono); font-size: 1.25rem; font-weight: 700; letter-spacing: .06em; color: var(--brand); }
  .v-form .linebtn { margin-top: 10px; background: var(--ok); color: #fff; font-size: .75rem; font-weight: 700; border-radius: 999px; padding: 6px 12px; display: inline-block; }
  .v-phone {
    position: absolute; right: 2%; top: 0; width: 42%; max-width: 210px; aspect-ratio: 9 / 18;
    background: #111827; border-radius: 30px; padding: 9px; box-shadow: var(--shadow);
  }
  .v-phone .screen { background: #EEF2F7; border-radius: 22px; height: 100%; padding: 14px 10px 10px; display: flex; flex-direction: column; gap: 8px; font-size: .6875rem; line-height: 1.5; }
  .v-phone .head { text-align: center; font-weight: 700; font-size: .6875rem; color: var(--ink-2); margin-bottom: 4px; }
  .msg-r, .msg-l { max-width: 85%; padding: 7px 10px; border-radius: 12px; }
  .msg-r { align-self: flex-end; background: #BFEBC4; border-bottom-right-radius: 4px; }
  .msg-l { align-self: flex-start; background: #fff; border-bottom-left-radius: 4px; }
  .v-thread { position: absolute; left: 8%; bottom: 0; width: 72%; padding: 12px 14px; font-size: .75rem; line-height: 1.55; }
  .v-thread .t-head { font-size: .6875rem; color: var(--ink-3); font-weight: 700; margin-bottom: 6px; }
  .t-row { display: grid; grid-template-columns: 22px 1fr; gap: 8px; padding: 6px 0; border-top: 1px dashed var(--line); }
  .t-row:first-of-type { border-top: 0; }
  .t-av { width: 22px; height: 22px; border-radius: 6px; background: var(--brand-l); color: var(--brand); font-size: .5625rem; font-weight: 800; display: grid; place-items: center; }
  img.t-av { background: #dde1f4; object-fit: cover; flex: none; }
  .t-row .m { color: var(--brand); font-weight: 700; }
  .img-note { position: absolute; right: 0; bottom: -26px; font-size: .6875rem; color: var(--ink-3); }
  .float-badge {
    position: absolute; right: 0; bottom: 34%; background: var(--accent); font-weight: 800; font-size: .8125rem;
    border-radius: 12px; padding: 8px 12px; box-shadow: var(--shadow-s); line-height: 1.4;
  }
  @media (max-width: 559px) {
    .visual { min-height: 0; display: grid; gap: 14px; }
    .v-form, .v-phone, .v-thread, .float-badge, .img-note { position: static; width: auto; max-width: none; }
    .v-phone { display: none; }
    .float-badge { justify-self: start; }
  }

  /* ── 共通セクション ── */
  section { padding: 72px 0; }
  @media (min-width: 960px) { section { padding: 104px 0; } }
  .sec-bg { background: var(--bg-2); }
  .sec-head { text-align: center; max-width: 760px; margin: 0 auto 48px; }
  .eyebrow { display: inline-block; color: var(--brand); font-weight: 800; font-size: .8125rem; letter-spacing: .14em; margin-bottom: 10px; }
  h2 { font-size: clamp(1.5rem, 3.6vw, 2.25rem); line-height: 1.45; font-weight: 800; margin: 0 0 16px; letter-spacing: .01em; }
  h3 { font-size: 1.125rem; font-weight: 800; line-height: 1.55; margin: 0; }
  .sec-head p { color: var(--ink-2); margin: 0; }
  p { margin: 0; }

  /* ── 数字の帯 ── */
  .stats { margin-top: -48px; position: relative; z-index: 2; }
  .stats-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); background: #fff; border-radius: var(--radius);
    box-shadow: var(--shadow); border: 1px solid var(--line); overflow: hidden;
  }
  @media (min-width: 768px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }
  .stat { padding: 22px 14px; text-align: center; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .stat:nth-child(2n) { border-right: 0; }
  @media (min-width: 768px) { .stat { border-bottom: 0; } .stat:nth-child(2n) { border-right: 1px solid var(--line); } .stat:last-child { border-right: 0; } }
  .stat .k { font-size: .75rem; color: var(--ink-3); font-weight: 700; text-wrap: balance; }
  .stat .v { font-size: 1.75rem; font-weight: 800; color: var(--brand); line-height: 1.3; }
  .stat .v small { font-size: .875rem; color: var(--ink); margin-left: 2px; }
  .after-stats { margin-top: -56px; padding-top: 128px; }

  /* ── お悩み ── */
  .pains { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .pains { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .pains { grid-template-columns: repeat(3, 1fr); } }
  .pain { background: #fff; border-radius: var(--radius); padding: 24px; border: 1px solid var(--line); display: flex; gap: 14px; align-items: flex-start; }
  .pain .ic { flex: none; width: 44px; height: 44px; border-radius: 12px; background: #FFF1F1; color: #D14343; display: grid; place-items: center; }
  .pain .ic svg { width: 22px; height: 22px; }
  .pain p { font-weight: 700; line-height: 1.65; }
  .arrow-down { display: grid; place-items: center; margin: 40px auto 0; color: var(--brand); }
  .arrow-down svg { width: 40px; height: 40px; }
  .answer { text-align: center; margin-top: 12px; font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 800; line-height: 1.6; }

  /* ── ハブ図 ── */
  .hub { max-width: 860px; margin: 0 auto; }
  .hub > svg { width: 100%; height: auto; }
  .hub-legend { display: grid; gap: 16px; margin-top: 32px; }
  @media (min-width: 768px) { .hub-legend { grid-template-columns: repeat(3, 1fr); } }
  .hub-legend div { background: #fff; border-radius: var(--radius); padding: 20px; border: 1px solid var(--line); }
  .hub-legend b { color: var(--brand); }
  .hub-legend p { font-size: .9375rem; color: var(--ink-2); margin-top: 6px; }

  /* ── できること ── */
  .journey { list-style: none; padding: 0; margin: 0 auto 56px; max-width: 880px; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  .journey::before { content: ""; position: absolute; left: 10%; right: 10%; top: 27px; height: 3px; background: var(--line); }
  .journey li { position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  .j-dot { width: 56px; height: 56px; border-radius: 50%; background: #fff; border: 3px solid var(--line); display: grid; place-items: center; font-weight: 800; font-size: .8125rem; color: var(--ink-3); position: relative; }
  .journey li.on .j-dot { background: var(--brand); border-color: var(--brand); color: #fff; box-shadow: 0 6px 16px rgba(31,90,69,.3); }
  .j-t { font-size: .8125rem; font-weight: 700; color: var(--ink-2); line-height: 1.5; }
  .journey li.on .j-t { color: var(--brand); }
  @media (max-width: 559px) { .j-dot { width: 46px; height: 46px; font-size: .6875rem; } .journey::before { top: 22px; } .j-t { font-size: .6875rem; } }
  .benefit { display: grid; gap: 28px; align-items: center; padding: 40px 0; border-top: 1px solid var(--line); }
  .benefit:first-of-type { border-top: 0; }
  @media (min-width: 900px) { .benefit { grid-template-columns: 1.15fr .85fr; gap: 64px; padding: 56px 0; } .benefit.rev .b-text { order: 2; } }
  .b-no { font-family: var(--mono); font-weight: 800; font-size: 2.75rem; color: var(--brand); line-height: 1; margin-right: 12px; vertical-align: middle; }
  .b-when { display: inline-block; vertical-align: middle; background: var(--accent); font-weight: 800; font-size: .875rem; border-radius: 999px; padding: 3px 14px; }
  .benefit h3 { font-size: clamp(1.375rem, 3vw, 1.875rem); line-height: 1.45; margin: 16px 0 14px; }
  .benefit p { color: var(--ink-2); }
  .b-list { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 10px; }
  .b-list li { display: flex; gap: 10px; font-weight: 600; font-size: .9375rem; }
  .b-list svg { flex: none; width: 20px; height: 20px; color: var(--brand); margin-top: 4px; }
  .b-visual { background: linear-gradient(160deg, var(--brand-l), var(--brand-ll)); border-radius: 24px; padding: 32px 16px; display: grid; place-items: center; }
  .phone-s { width: 100%; max-width: 250px; background: #111827; border-radius: 32px; padding: 9px; box-shadow: var(--shadow); }
  .phone-s .scr { background: #EEF2F7; border-radius: 24px; min-height: 360px; padding: 18px 12px; display: flex; flex-direction: column; gap: 10px; font-size: .75rem; line-height: 1.55; }
  .p-time { align-self: center; font-size: .625rem; color: var(--ink-3); background: rgba(255,255,255,.7); border-radius: 999px; padding: 1px 10px; }
  .form-s { background: #fff; border-radius: 12px; padding: 12px; display: grid; gap: 6px; }
  .f-q { font-weight: 700; font-size: .6875rem; }
  .f-scale { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; }
  .f-scale span { border: 1px solid var(--line); border-radius: 6px; text-align: center; font-size: .6875rem; padding: 2px 0; }
  .f-scale span.on { background: var(--brand); border-color: var(--brand); color: #fff; font-weight: 700; }
  .b-note { text-align: center; font-size: .875rem; color: var(--ink-2); background: var(--wip-l); border-radius: 12px; padding: 12px 16px; margin: 8px auto 12px; max-width: 760px; }
  .f-opt { border: 1px solid var(--line); border-radius: 8px; padding: 4px 8px; font-size: .6875rem; }
  .f-opt.on { border-color: var(--brand); background: var(--brand-l); color: var(--brand); font-weight: 700; }
  .f-btn { background: var(--brand); color: #fff; text-align: center; border-radius: 999px; padding: 5px; font-weight: 700; font-size: .6875rem; margin-top: 4px; }

  /* ── ステップ ── */
  .steps { display: grid; gap: 16px; }
  @media (min-width: 640px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(5, 1fr); gap: 14px; } }
  .step { position: relative; background: #fff; border-radius: var(--radius); padding: 22px 20px; border: 1px solid var(--line); box-shadow: var(--shadow-s); }
  .step .num { font-family: var(--mono); font-weight: 800; color: var(--brand); font-size: .8125rem; letter-spacing: .1em; }
  .step h3 { font-size: 1rem; margin: 6px 0 8px; }
  .step p { font-size: .875rem; color: var(--ink-2); line-height: 1.7; }
  .who { display: inline-block; font-size: .6875rem; font-weight: 800; border-radius: 999px; padding: 2px 10px; margin-top: 10px; }
  .who.cus { background: var(--brand-l); color: var(--brand); }
  .who.auto { background: var(--ok-l); color: var(--ok); }
  .who.staff { background: var(--wip-l); color: var(--wip); }
  .code { font-family: var(--mono); background: var(--bg-2); border: 1px solid var(--line); border-radius: 6px; padding: 0 6px; font-size: .8125rem; color: var(--ink); white-space: nowrap; }

  /* ── デモ（スレッド） ── */
  .demo { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .demo { grid-template-columns: 1fr 1.15fr; gap: 56px; } }
  .checks { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
  .checks li { display: flex; gap: 10px; font-weight: 600; }
  .checks svg { flex: none; width: 22px; height: 22px; color: var(--brand); margin-top: 3px; }
  .thread { padding: 0; overflow: hidden; }
  .thread-top { display: flex; align-items: center; gap: 8px; padding: 12px 18px; border-bottom: 1px solid var(--line); font-weight: 700; font-size: .8125rem; color: var(--ink-2); background: var(--bg-2); }
  .thread-top i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
  .tm { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); font-size: .875rem; line-height: 1.65; }
  .tm:last-child { border-bottom: 0; }
  .tm.parent { background: var(--brand-ll); }
  .av { width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; font-size: .6875rem; font-weight: 800; }
  .av.bot { background: var(--brand); color: #fff; }
  img.av.bot { background: #dde1f4; object-fit: cover; }
  .av.hum { background: var(--wip-l); color: var(--wip); }
  .tm .name { font-weight: 800; font-size: .8125rem; }
  .tm .name time { font-weight: 500; color: var(--ink-3); font-size: .75rem; margin-left: 8px; }
  .tm .body { color: var(--ink-2); }
  .tm .m { color: var(--brand); font-weight: 700; }
  .tm .q { border-left: 3px solid var(--line); padding-left: 10px; margin-top: 4px; color: var(--ink-3); }
  .demo-note { font-size: .75rem; color: var(--ink-3); margin-top: 10px; }

  /* ── 機能 ── */
  .features { display: grid; gap: 20px; }
  @media (min-width: 640px) { .features { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .features { grid-template-columns: repeat(3, 1fr); } }
  .feature { background: #fff; border-radius: var(--radius); padding: 28px 24px; border: 1px solid var(--line); }
  .feature .ic { width: 52px; height: 52px; border-radius: 14px; background: var(--brand-l); color: var(--brand); display: grid; place-items: center; margin-bottom: 16px; }
  .feature .ic svg { width: 26px; height: 26px; }
  .feature p { color: var(--ink-2); font-size: .9375rem; margin-top: 8px; }

  /* ── 業種 ── */
  .inds { display: grid; gap: 14px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 768px) { .inds { grid-template-columns: repeat(3, 1fr); } }
  .ind { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 12px; text-align: center; font-weight: 700; font-size: .9375rem; line-height: 1.6; }
  .ind .ic { width: 48px; height: 48px; margin: 0 auto 10px; border-radius: 50%; background: var(--brand-l); color: var(--brand); display: grid; place-items: center; }
  .ind .ic svg { width: 24px; height: 24px; }
  .ind-note { text-align: center; color: var(--ink-2); font-size: .875rem; margin-top: 24px; }

  /* ── 選ばれる理由 ── */
  .reasons { display: grid; gap: 20px; }
  @media (min-width: 960px) { .reasons { grid-template-columns: repeat(3, 1fr); } }
  .reason { background: #fff; border-radius: var(--radius); padding: 32px 26px; border: 1px solid var(--line); position: relative; }
  .reason .no { font-size: 3rem; font-weight: 800; color: var(--brand-l); line-height: 1; position: absolute; right: 22px; top: 18px; font-family: var(--mono); }
  .reason .lbl { color: var(--brand); font-weight: 800; font-size: .75rem; letter-spacing: .14em; }
  .reason h3 { font-size: 1.25rem; margin: 6px 0 12px; position: relative; }
  .reason p { color: var(--ink-2); font-size: .9375rem; }
  .reason a { color: var(--brand); font-weight: 700; }

  /* ── 導入の流れ ── */
  .flow { max-width: 860px; margin: 0 auto; }
  .flow ol { padding: 0; margin: 0; display: grid; gap: 12px; }
  .flow li { list-style: none; display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 16px; align-items: start; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
  .flow .n { width: 52px; height: 52px; border-radius: 50%; background: var(--brand); color: #fff; display: grid; place-items: center; font-weight: 800; font-family: var(--mono); font-size: 1.0625rem; }
  .flow p { color: var(--ink-2); font-size: .9375rem; margin-top: 4px; }

  /* ── 料金 ── */
  .plans { display: grid; gap: 20px; max-width: 960px; margin: 0 auto; }
  @media (min-width: 768px) { .plans { grid-template-columns: 1fr 1fr; } }
  .plan { background: #fff; border-radius: 20px; padding: 32px 26px; border: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px; }
  .plan.main { border: 2px solid var(--brand); box-shadow: var(--shadow); }
  .plan .pl { font-weight: 800; color: var(--brand); font-size: .875rem; }
  .plan .price { font-size: 1.75rem; font-weight: 800; line-height: 1.3; }
  .plan .price small { font-size: .875rem; color: var(--ink-2); font-weight: 600; }
  .plan ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: .9375rem; color: var(--ink-2); }
  .plan li { display: flex; gap: 8px; }
  .plan li svg { flex: none; width: 18px; height: 18px; color: var(--brand); margin-top: 5px; }
  .plan .btn { margin-top: auto; align-self: flex-start; }

  /* ── FAQ ── */
  .faq { max-width: 860px; margin: 0 auto; display: grid; gap: 12px; }
  .faq details { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 0 20px; }
  .faq summary { cursor: pointer; list-style: none; display: grid; grid-template-columns: 24px minmax(0, 1fr) 20px; gap: 10px; align-items: center; font-weight: 700; padding: 18px 0; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary .q { color: var(--brand); font-weight: 800; font-family: var(--mono); font-size: 1.125rem; }
  .faq summary .pm { width: 20px; height: 20px; color: var(--ink-3); transition: transform .2s ease; }
  .faq details[open] summary .pm { transform: rotate(45deg); }
  .faq details p { padding: 0 0 20px 34px; color: var(--ink-2); font-size: .9375rem; }

  /* ── 最後のCTA ── */
  .final { background: linear-gradient(135deg, var(--brand) 0%, var(--brand-d) 100%); color: #fff; text-align: center; }
  .final h2 { color: #fff; }
  .final p { opacity: .92; max-width: 40em; margin: 0 auto; }
  .final .row { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 32px; align-items: flex-end; }
  .final .btn-primary { background: #fff; color: var(--brand); box-shadow: 0 8px 20px rgba(0,0,0,.18); }
  .final .btn-primary:hover { background: var(--accent); color: var(--ink); }
  .final .btn-ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,.7); }
  .final .btn-ghost:hover { background: rgba(255,255,255,.12); }
  .final .meta { font-size: .8125rem; opacity: .8; margin-top: 18px; }

  footer.site { background: #0F2219; color: #AEB8CC; padding: 40px 0 96px; font-size: .8125rem; }
  footer.site .container { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; }
  footer.site a { color: #fff; text-decoration: none; }
  footer.site a:hover { text-decoration: underline; }

  /* ── 追従CTA ── */
  .floating {
    position: fixed; right: 16px; bottom: 16px; z-index: 60;
    display: flex; align-items: center; gap: 10px; background: var(--brand); color: #fff; text-decoration: none;
    border-radius: 999px; padding: 8px 18px 8px 8px; box-shadow: 0 10px 24px rgba(23, 42, 90, .3);
    font-weight: 800; font-size: .875rem; line-height: 1.3; transition: transform .15s ease, background .15s ease;
  }
  .floating:hover { transform: translateY(-2px); background: var(--brand-d); }
  .floating .ic { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: var(--ink); display: grid; place-items: center; }
  .floating .ic svg { width: 18px; height: 18px; }
  .floating small { display: block; font-size: .6875rem; font-weight: 600; opacity: .85; }

  .reveal { opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal { opacity: 1; transform: none; transition: none; }
    * { transition-duration: 1ms !important; }
  }

  /* ── リマインド人追加分 ── */
  .v-form { width: 56%; }
  @media (max-width: 559px) { .v-form { width: auto; } }
  .mn { color: var(--brand); font-weight: 700; }
  .mk { border-radius: 6px; padding: 0 5px; font-weight: 700; }
  .m-b { background: var(--brand-l); color: var(--brand); } .m-o { background: var(--wip-l); color: var(--wip); } .m-g { background: var(--ok-l); color: var(--ok); } .m-r { background: #FFF1F1; color: #D14343; }
  .mflow { display: grid; grid-template-columns: 1fr 40px 1fr 40px 1fr; align-items: stretch; margin: 0 auto 56px; max-width: 1000px; }
  .mflow .fc { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-s); padding: 20px 18px; font-size: .875rem; line-height: 1.75; }
  .mflow .cap { display: inline-block; font-size: .75rem; font-weight: 800; color: #fff; background: var(--brand); border-radius: 999px; padding: 2px 12px; margin-bottom: 12px; }
  .mflow .arr { display: grid; place-items: center; color: var(--brand); }
  .mflow .arr svg { width: 26px; height: 26px; }
  .mflow .ex { display: grid; gap: 8px; }
  .mflow .ex div { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; border-radius: 10px; background: var(--bg-2); border: 1px solid var(--line); }
  .mflow .ex span:first-child { font-size: .75rem; color: var(--ink-3); }
  .mflow .tcard { margin-top: 10px; background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  .mflow .tcard .mt { font-size: .75rem; color: var(--ink-3); }
  .chip { display: inline-block; font-size: .6875rem; font-weight: 700; border-radius: 999px; padding: 2px 10px; margin: 6px 6px 0 0; border: 1px solid var(--line); background: #fff; }
  .chip.p { background: var(--brand); border-color: var(--brand); color: #fff; }
  .alt { text-align: center; color: var(--ink-2); font-size: .875rem; margin: -32px 0 48px; }
  @media (max-width: 799px) { .mflow { grid-template-columns: 1fr; } .mflow .arr { height: 36px; transform: rotate(90deg); } .alt { margin-top: -24px; } }

  /* ── リラクゼーション店舗 AIコンサル 追加分 ── */
  .logo-mark { color: #fff; }
  .visual.sa { min-height: 500px; }
  .v-inbox { position: absolute; left: 0; top: 0; width: 72%; padding: 16px 18px; z-index: 1; }
  .v-inbox .bar { display: flex; gap: 5px; margin-bottom: 10px; }
  .v-inbox .bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--line); }
  .v-inbox .label { font-size: .6875rem; color: var(--ink-3); font-weight: 700; }
  .say-me { font-size: .8125rem; line-height: 1.65; font-weight: 700; margin: 4px 0 10px; }
  .sorted { display: grid; gap: 6px; }
  .sorted div { display: grid; grid-template-columns: auto auto 1fr; gap: 8px; align-items: center; background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; padding: 6px 10px; font-size: .75rem; }
  .sorted em { font-style: normal; color: var(--ink-3); text-align: right; white-space: nowrap; font-size: .6875rem; }
  .sorted b { white-space: nowrap; }
  .v-admin { position: absolute; right: 0; bottom: 24px; width: 70%; padding: 14px 16px; font-size: .75rem; line-height: 1.55; z-index: 2; }
  .visual.sa .float-badge { right: auto; left: 4%; bottom: 150px; z-index: 3; }
  br.pc { display: none; } @media (min-width: 960px) { br.pc { display: inline; } }
  .v-admin .t-head { font-size: .6875rem; color: var(--ink-3); font-weight: 700; margin-bottom: 8px; }
  .shift { display: grid; grid-template-columns: 1.6fr repeat(5, 1fr); gap: 4px; align-items: center; margin-bottom: 10px; }
  .shift > * { text-align: center; border-radius: 6px; padding: 3px 0; font-size: .6875rem; }
  .shift > span:first-child { text-align: left; font-weight: 700; white-space: nowrap; }
  .shift s { background: #FFF1F1; color: #D14343; }
  .shift .ok { background: var(--brand-l); color: var(--brand); font-weight: 700; }
  .ai-row { display: grid; grid-template-columns: 22px 1fr; gap: 8px; margin-bottom: 4px; }
  .ai-row .t-av { background: var(--brand); color: #fff; }
  .v-admin .chip { margin-top: 4px; }

  /* 管理画面の before/after・事例のビジュアル・当日の配分 */
  .ba-mock { display: grid; grid-template-columns: 1fr 48px 1fr; align-items: center; gap: 0; max-width: 960px; margin: 40px auto 8px; position: relative; }
  .ba-mock .img-note { grid-column: 1 / -1; text-align: right; font-size: .75rem; color: var(--ink-3); margin: 8px 0 0; }
  .bm { position: relative; padding-top: 14px; }
  .bm-tag { position: absolute; top: 0; left: 18px; z-index: 1; font-size: .75rem; font-weight: 800; border-radius: 999px; padding: 2px 12px; background: var(--ink-2); color: #fff; }
  .bm-tag.a { background: var(--brand); }
  .bm-screen { padding: 22px 18px 16px; font-size: .8125rem; line-height: 1.6; }
  .bm.before .bm-screen { background: #fff; opacity: .92; }
  .bm-bar { display: flex; align-items: center; gap: 5px; margin-bottom: 10px; font-size: .6875rem; color: var(--ink-3); font-weight: 700; }
  .bm-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--line); }
  .bm-bar span { margin-left: 6px; }
  .shift .on { background: var(--bg-2); border: 1px solid var(--line); }
  .bm-steps { display: flex; flex-wrap: wrap; gap: 6px; }
  .bm-steps span { font-size: .6875rem; background: #FFF1F1; color: #D14343; border-radius: 6px; padding: 2px 8px; font-weight: 700; }
  .bm-note { margin: 10px 0 0; font-size: .8125rem; color: var(--ink-2); }
  .bm-arr { display: grid; place-items: center; color: var(--brand); }
  .bm-arr svg { width: 28px; height: 28px; }
  @media (max-width: 767px) { .ba-mock { grid-template-columns: 1fr; } .bm-arr { height: 40px; transform: rotate(90deg); } }
  .c-shot { margin: 0; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: var(--bg-2); }
  .c-vis { aspect-ratio: 16 / 9; position: relative; overflow: hidden; }
  .c-vis img { width: 100%; height: 100%; object-fit: cover; }
  .c-shot figcaption { background: #fff; padding: 6px 12px; font-size: .75rem; color: var(--ink-3); border-top: 1px solid var(--line); }
  .mock-sheet { position: absolute; inset: 10px; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: .6875rem; line-height: 1.5; display: grid; align-content: space-between; gap: 6px; }
  .mock-sheet .bm-bar { margin: 0; }
  .ms-grid { display: grid; grid-template-columns: 1fr 1fr 1.4fr; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .ms-grid span { padding: 2px 8px; border-bottom: 1px solid var(--line); }
  .ms-grid .h { background: var(--brand-l); color: var(--brand); font-weight: 800; }
  .ms-grid .mask { background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 9px); background-clip: content-box; height: 1.5em; }
  .mock-sheet .ai-row { margin: 0; font-size: .75rem; }
  .mock-cal { position: absolute; inset: 10px; display: grid; grid-template-columns: 1fr 92px 1fr; align-items: center; gap: 6px; }
  .mc-col { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; display: grid; gap: 5px; height: 100%; align-content: start; overflow: hidden; }
  .mc-h { white-space: nowrap; font-size: .625rem; font-weight: 800; color: var(--ink-3); }
  .mc-col i { height: 14px; border-radius: 5px; background: var(--bg-2); border-left: 4px solid var(--ink-3); }
  .mc-col i.s { width: 70%; }
  .mc-col.g i { background: var(--brand-l); border-left-color: var(--brand); }
  .mc-col.g .mc-h { color: var(--brand); }
  .mc-arr { display: grid; justify-items: center; gap: 4px; color: var(--brand); text-align: center; }
  .mc-arr svg { width: 24px; height: 24px; }
  .mc-arr small { font-size: .625rem; line-height: 1.4; color: var(--ink-2); font-weight: 700; }
  .mc-arr .t-av { background: var(--brand); color: #fff; }
  .day-bar { max-width: 860px; margin: 0 auto 32px; }
  .db-title { font-size: .875rem; font-weight: 800; color: var(--brand); margin-bottom: 8px; }
  .db-row { display: flex; gap: 4px; }
  .db-row > div { min-width: 0; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 10px 8px; display: grid; gap: 2px; text-align: center; }
  .db-row b { font-size: .8125rem; line-height: 1.35; }
  .db-row small { font-size: .6875rem; color: var(--ink-3); }
  .db-row .main { background: var(--brand); border-color: var(--brand); color: #fff; }
  .db-row .main small { color: rgba(255,255,255,.8); }
  @media (max-width: 559px) { .db-row { flex-direction: column; } .db-row > div { flex: none !important; display: flex; justify-content: space-between; text-align: left; } }
  @media (max-width: 559px) { .visual.sa { min-height: 0; } .v-inbox, .v-admin { position: static; width: auto; } .visual.sa .float-badge { position: static; } }
  .case-video { max-width: 860px; margin: 0 auto 40px; }
  .vframe { position: relative; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); background: #0F2219; }
  .vframe iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .case-video .demo-note { text-align: center; }
  .case-profile { max-width: 960px; margin: 0 auto 32px; display: grid; gap: 12px; }
  @media (min-width: 768px) { .case-profile { grid-template-columns: repeat(3, 1fr); } }
  .case-profile div { background: var(--brand-ll); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; }
  .case-profile span { display: block; font-size: .75rem; color: var(--brand); font-weight: 800; letter-spacing: .06em; }
  .case-profile b { font-size: .9375rem; line-height: 1.6; }
  .cases { display: grid; gap: 20px; max-width: 960px; margin: 0 auto; }
  @media (min-width: 768px) { .cases { grid-template-columns: 1fr 1fr; } }
  .case { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow-s); display: grid; gap: 12px; align-content: start; }
  .c-top { display: flex; align-items: center; gap: 12px; }
  .c-no { width: 40px; height: 40px; border-radius: 50%; background: var(--brand); color: #fff; display: grid; place-items: center; font-family: var(--mono); font-weight: 800; flex: none; }
  .ba { display: grid; gap: 8px; }
  .ba div { border-radius: 10px; padding: 10px 12px; font-size: .875rem; line-height: 1.7; }
  .ba .b { background: var(--bg-2); color: var(--ink-2); }
  .ba .a { background: var(--brand-l); color: var(--brand-d); }
  .ba b { display: block; font-size: .75rem; letter-spacing: .06em; }
  .voice { font-weight: 800; color: var(--brand); }
  .quotes { display: grid; gap: 16px; max-width: 960px; margin: 40px auto 0; }
  @media (min-width: 900px) { .quotes { grid-template-columns: repeat(3, 1fr); } }
  blockquote { margin: 0; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: var(--radius); padding: 20px 22px; }
  blockquote p { font-weight: 800; line-height: 1.65; }
