  @keyframes pulse { from { box-shadow: 0 0 0 0 rgba(52,211,153,.7); } to { box-shadow: 0 0 0 8px rgba(52,211,153,0); } }
  .cs-say { font-size: .875rem; font-weight: 700; line-height: 1.6; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); border-radius: 12px; padding: 10px 12px; margin-bottom: 12px; }
