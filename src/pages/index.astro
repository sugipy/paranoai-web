  .prods .pr.ask { color: var(--ink-3); font-family: var(--font); }
  .prods .go { width: 18px; height: 18px; color: var(--brand); }
  @media (max-width: 479px) { .prods a { grid-template-columns: minmax(0, 1fr) 18px; } .prods .pr { grid-column: 1; text-align: left; } .prods .go { grid-row: 1 / span 2; grid-column: 2; } }
  .door-note { font-size: .8125rem; color: var(--ink-3); }
  .door-note a { color: var(--brand); font-weight: 700; }

  /* 進め方の3段 */
  .ladder { display: grid; gap: 20px; position: relative; }
  @media (min-width: 900px) { .ladder { grid-template-columns: repeat(3, 1fr); } .ladder::before { content: ""; position: absolute; left: 16%; right: 16%; top: 51px; border-top: 2px dashed var(--brand-l); } }
  .rung { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 24px; display: flex; flex-direction: column; gap: 10px; box-shadow: var(--shadow-s); }
