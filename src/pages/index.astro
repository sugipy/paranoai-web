  .pa-memo ol { margin: 0; padding-left: 1.3em; font-size: .8125rem; line-height: 1.75; font-weight: 700; }
  .pa-cal { padding: 12px 16px; display: grid; grid-template-columns: 40px 1fr; gap: 12px; align-items: center; }
  .pa-cal .ic { width: 40px; height: 40px; border-radius: 10px; background: var(--brand); color: #fff; display: grid; place-items: center; }
  .pa-cal .ic svg { width: 22px; height: 22px; }
  .pa-cal b { display: block; font-size: .875rem; line-height: 1.4; }
  .pa-cal small { font-size: .75rem; color: var(--ink-3); }
  .reason { display: flex; flex-direction: column; }
  .r-vis { margin-top: auto; padding-top: 18px; }
  .r-box { background: var(--bg-2); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; font-size: .75rem; line-height: 1.5; display: grid; gap: 6px; }
