  .price-note { max-width: 860px; margin: 14px auto 0; font-size: .8125rem; color: var(--ink-3); text-align: center; }
  @media (max-width: 559px) { .price-list .row { grid-template-columns: 40px minmax(0, 1fr); gap: 4px 12px; padding: 14px 18px; } .price-list .v { grid-column: 2; text-align: left; } }

  /* 運営者 */
  .about { display: grid; gap: 32px; align-items: start; max-width: 960px; margin: 0 auto; }
  @media (min-width: 900px) { .about { grid-template-columns: 1.2fr 1fr; gap: 48px; } }
  .about-text { display: grid; gap: 16px; color: var(--ink-2); }
  .about-text .name { font-weight: 800; color: var(--ink); font-size: 1.25rem; }
  .about-text .name small { font-size: .8125rem; color: var(--ink-3); font-weight: 600; margin-left: 8px; }
  .about-text a { color: var(--brand); font-weight: 700; }
  .made { background: var(--brand-ll); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
