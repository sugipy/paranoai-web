  .r-line .t-av { background: var(--brand); color: #fff; flex: none; }
  .r-line .chip { margin: 0; flex: none; }

  /* ── ファーストビュー（AIの自動化を前に出す版） ── */
  .hero.hero-ai {
    color: #fff;
    background:
      radial-gradient(720px 440px at 82% 22%, rgba(52, 211, 153, .30) 0%, transparent 65%),
      radial-gradient(620px 420px at 6% 96%, rgba(56, 189, 248, .16) 0%, transparent 65%),
